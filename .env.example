# Backend configuration
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional locally; SQLite is used when this is empty. In production, set a PostgreSQL URL.
DATABASE_URL=
GOOGLE_CLIENT_ID=
# Generate a random value of at least 32 characters for signed browser sessions.
SESSION_SECRET=

# Frontend: leave empty locally to use the Vite /api proxy.
VITE_API_BASE_URL=
